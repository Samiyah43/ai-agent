# Copy this file to .env and replace the placeholder with your own API key.
# Never share or commit the .env file.

# --- Using Groq (free, no credit card needed) ---
# 1. Sign up at https://console.groq.com/keys and create a free API key.
# 2. Paste it below.
OPENAI_API_KEY=your_groq_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# gpt-oss-120b is the larger sibling of gpt-oss-20b: same tool-call format
# (reliable with Groq's OpenAI-compatible endpoint), but bigger, so it's more
# likely to actually decide to call a tool (e.g. web_search) instead of
# answering from its own possibly-outdated training knowledge.
OPENAI_MODEL=openai/gpt-oss-120b

# --- Using real OpenAI instead ---
# Remove the OPENAI_BASE_URL line above and set OPENAI_MODEL=gpt-5-mini (needs billing set up).

PORT=3000

# Postgres connection string. For local dev, run (port 5433 avoids clashing with
# any native Postgres install already using 5432):
#   docker run --name ai-agent-postgres -e POSTGRES_USER=aiagent -e POSTGRES_PASSWORD=aiagent_dev_pw -e POSTGRES_DB=ai_agent -p 5433:5432 -d postgres:16-alpine
DATABASE_URL="postgresql://aiagent:aiagent_dev_pw@localhost:5433/ai_agent"

# --- Web search tool (optional) ---
# 1. Sign up at https://tavily.com and create a free API key (1000 searches/month free).
# 2. Paste it below. Without this, the web_search tool will return an error when called.
TAVILY_API_KEY=your_tavily_api_key_here
