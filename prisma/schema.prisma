// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// A tenant of the system — e.g. a business that pays to use this agent.
// Every document, conversation, and API key belongs to exactly one client,
// so one client's data is never visible to another.
model Client {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now())
  apiKeys   ApiKey[]
  documents Document[]
  messages  Message[]
}

model Message {
  id             Int      @id @default(autoincrement())
  clientId       Int
  conversationId String
  role           String
  data           String
  createdAt      DateTime @default(now())
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, conversationId])
}

// A source document that was ingested into the knowledge base (e.g. a policy
// or FAQ). Kept in full so it can be re-chunked later if the chunking
// strategy changes.
model Document {
  id        Int      @id @default(autoincrement())
  clientId  Int
  title     String
  content   String
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  chunks    Chunk[]

  @@index([clientId])
}

// A chunk of a Document, plus its embedding vector (stored as a JSON string
// since SQLite has no native vector type). Similarity is computed in
// JavaScript at query time.
model Chunk {
  id         Int      @id @default(autoincrement())
  documentId Int
  content    String
  embedding  String
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// An API key issued to a client that is allowed to call the agent's
// endpoints. Only the SHA-256 hash of the key is stored — the plaintext key
// is shown once at creation time and never persisted.
model ApiKey {
  id         Int       @id @default(autoincrement())
  clientId   Int
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@index([clientId])
}
